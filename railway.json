{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile"
  },
  "deploy": {
    "startCommand": "/opt/keycloak/bin/kc.sh start",
    "restartPolicyMaxRetries": 5,
    "healthchecks": {
      "readiness": {
        "path": "/health/ready",
        "initialDelaySeconds": 40,
        "periodSeconds": 10,
        "timeoutSeconds": 3,
        "successThreshold": 1,
        "failureThreshold": 3
      },
      "liveness": {
        "path": "/health/live",
        "initialDelaySeconds": 40,
        "periodSeconds": 30,
        "timeoutSeconds": 3,
        "successThreshold": 1,
        "failureThreshold": 3
      }
    }
  },
  "variables": {
    "KC_LOG_LEVEL": "INFO",
    "KC_PROXY_HEADERS": "forwarded",
    "KC_HOSTNAME_STRICT": "false",
    "KC_HOSTNAME_STRICT_HTTPS": "false"
  }
}
