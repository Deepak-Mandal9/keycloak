# Keycloak Railway Deployment Configuration Example
# Copy this file to .env and fill in the actual values

# ========== DATABASE CONFIGURATION ==========
# These are typically auto-set by Railway PostgreSQL plugin
# But you can override them if needed

KC_DB_URL=jdbc:postgresql://localhost:5432/keycloak
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=your-secure-password-here

# ========== KEYCLOAK HOSTNAME & PORT ==========
# This should be your Railway app domain
KC_HOSTNAME=keycloak-app.railway.app
KC_HTTP_PORT=8080

# ========== HTTP/HTTPS CONFIGURATION ==========
# Railway handles SSL termination automatically
KC_HTTP_ENABLED=true
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false

# ========== PROXY CONFIGURATION ==========
# Railway uses reverse proxy
KC_PROXY=reencrypt
KC_PROXY_HEADERS=forwarded

# ========== LOGGING ==========
KC_LOG_LEVEL=INFO

# ========== JAVA CONFIGURATION ==========
# Memory settings - adjust based on Railway plan
# For hobby tier: 256m-512m
# For production: 512m-2048m
JAVA_OPTS=-Xms512m -Xmx1024m

# ========== HEALTH & METRICS ==========
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true

# ========== EMAIL CONFIGURATION (Optional) ==========
# Required if you want to enable email functionality
KC_SPI_EMAIL_DEFAULT_FROM=noreply@your-domain.com
KC_SPI_EMAIL_DEFAULT_FROM_DISPLAY_NAME=Keycloak
KC_SPI_EMAIL_DEFAULT_HOST=smtp.gmail.com
KC_SPI_EMAIL_DEFAULT_PORT=587
KC_SPI_EMAIL_DEFAULT_AUTH=true
KC_SPI_EMAIL_DEFAULT_USER=your-email@gmail.com
KC_SPI_EMAIL_DEFAULT_PASSWORD=your-app-password

# ========== CACHE CONFIGURATION ==========
# For distributed setup (multiple replicas)
KC_CACHE=ispn
KC_CACHE_CONFIG_FILE=/opt/keycloak/conf/cache-ispn.xml

# ========== DATABASE POOL SETTINGS ==========
KC_DB_POOL_INITIAL_SIZE=10
KC_DB_POOL_MAX_SIZE=20
KC_DB_POOL_MIN_SIZE=5

# ========== ADMIN USER (Initial Setup) ==========
# Only used during first deployment
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-production

# ========== FEATURES ==========
# Enable/disable Keycloak features
KC_FEATURES=
# Examples:
# KC_FEATURES=docker
# KC_FEATURES=token-exchange
# KC_FEATURES=admin-fine-grained-authz

# ========== SECURITY & CORS ==========
# Adjust based on your needs
KC_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,HEAD
KC_CORS_EXPOSED_RESPONSE_HEADERS=WWW-Authenticate,My-Custom-Header

# ========== SESSION CONFIGURATION ==========
# Important for distributed deployments
KC_SPI_STICKY_SESSION_ENCODER_INFINISPAN_SHOULD_ATTACH_ROUTE=false
KC_SESSION_CACHE=ispn

# ========== OBSERVABILITY ==========
# For monitoring and debugging
KC_SPI_METRICS_ENABLED=true
KC_SPI_DBLOCK_PROVIDER=jpa
